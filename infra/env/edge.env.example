# infra/env/edge.env.example
#
# Template das variáveis de ambiente esperadas pelo dispositivo
# (edge/src/config.py). Configurar diretamente no Raspberry Pi
# (nunca versionar um .env real).

API_BASE_URL=

# Credencial DESTE dispositivo, gerada por
# `python -m scripts.provisionar_dispositivo <device_id> "<nome>"` no
# cloud/ (ADR 0009). O valor em claro aparece UMA VEZ, na saída do
# script: o banco guarda só o hash. Se perder, rode o script de novo
# para gerar outro.
#
# O nome da variável continua DEVICE_API_KEY por compatibilidade com
# edge/src/config.py e com os Pis já provisionados, mas o conteúdo não é
# mais a chave global compartilhada: é o segredo deste aparelho.
DEVICE_API_KEY=

# Tem que bater EXATAMENTE com o device_id usado no provisionamento.
# Divergência aqui não gera erro de configuração: a credencial é
# recusada e todas as capturas voltam 401.
DEVICE_ID=
CAPTURE_INTERVAL_MINUTES=120
QUEUE_DRAIN_INTERVAL_MINUTES=15

# --- Pinos GPIO ---
LED_MOSFET_PIN=18
DHT22_PIN=4
# Tempo de espera com o LED já aceso antes de disparar a câmera (garante
# que a foto não saia mal iluminada por causa do LED ainda subindo de brilho).
LED_FLASH_DURATION_SECONDS=0.5

# --- ADS1115 (sensor de umidade do solo, I2C) ---
# Canal analógico do ADS. Normalmente 0, mas é configurável porque o
# pino A0 pode não fazer contato: no ecovision-pi-01 a montagem usa o
# canal 1 por esse motivo (ver docs/decisions/0015-ads1115-por-smbus2.md).
SOIL_ADS1115_CHANNEL=0
# OBRIGATÓRIO calibrar por dispositivo: estes valores dependem do sensor
# e da tensão que o alimenta, e os abaixo são placeholders de fabricante.
# Como medir: leia o valor bruto com o sensor seco suspenso no ar
# (SOIL_DRY_RAW) e enfiado na terra úmida até a linha (SOIL_WET_RAW).
# Referência do ecovision-pi-01, alimentado em 3,3V: 17468 seco no ar,
# 7179 submerso em água. Em terra o extremo molhado será maior que esse.
SOIL_DRY_RAW=18000
SOIL_WET_RAW=8000

# --- Compressão de imagem ---
JPEG_QUALITY=70

# --- Fila offline (cache local no SD card) ---
# Opcional. Por padrão usa <repo>/edge/data/queue, calculado a partir do
# local do script (não do diretório de trabalho de quem chamou). Só
# definir aqui se precisar apontar para outro lugar (ex.: disco externo).
# QUEUE_DIR=

# --- Upload / retry ---
UPLOAD_TIMEOUT_SECONDS=30
UPLOAD_MAX_RETRIES=5
UPLOAD_BACKOFF_FACTOR=1.0
