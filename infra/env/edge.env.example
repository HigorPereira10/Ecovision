# Variáveis de ambiente do dispositivo (edge/src/config.py).
# Copiar para edge/.env no Raspberry Pi. Nunca versionar valores reais.

API_BASE_URL=

# Credencial deste dispositivo, exibida uma única vez por
# `python -m scripts.provisionar_dispositivo <device_id> "<nome>"` (em cloud/).
DEVICE_API_KEY=
# Deve ser idêntico ao usado no provisionamento; caso contrário, os envios voltam 401.
DEVICE_ID=
CAPTURE_INTERVAL_MINUTES=120
QUEUE_DRAIN_INTERVAL_MINUTES=15

# --- Pinos (numeração BCM) ---
LED_MOSFET_PIN=18
DHT22_PIN=4
# Espera, com o LED aceso, antes de disparar a câmera.
LED_FLASH_DURATION_SECONDS=0.5

# --- Sensor de solo (ADS1115) ---
# Canal analógico; use 1 se o pino A0 do módulo não fizer contato.
SOIL_ADS1115_CHANNEL=0
# Calibrar por dispositivo com edge/scripts/calibrar_solo.py: valor bruto
# com o sensor seco e com o sensor no extremo úmido.
SOIL_DRY_RAW=18000
SOIL_WET_RAW=8000

# --- Câmera ---
# Distância de foco fixo, em centímetros (0 usa o autofoco). Medir por
# dispositivo: com o autofoco ativo, LensPosition está em dioptrias e
# centímetros = 100 / LensPosition. A lente alcança de 6,7 cm ao infinito.
CAMERA_FOCUS_CM=0

# --- Compressão ---
JPEG_QUALITY=70

# --- Fila local ---
# Opcional; por padrão, edge/data/queue.
# QUEUE_DIR=

# --- Envio ---
UPLOAD_TIMEOUT_SECONDS=30
UPLOAD_MAX_RETRIES=5
UPLOAD_BACKOFF_FACTOR=1.0
