# infra/env/cloud.env.example
#
# Template das variáveis de ambiente esperadas pelo backend (cloud/app/config.py).
# Copiar para um .env real (NUNCA versionado) ou configurar diretamente
# nas variáveis de ambiente do serviço no Railway.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ecovision-imagens

# ATENÇÃO: usar a string do "Session pooler" (Connect -> aba "Direct
# Connection" -> opção "Session pooler"), NÃO a "Direct connection".
# A Direct connection só resolve em IPv6 (db.<projeto>.supabase.co), e
# nem toda rede/provedor tem rota IPv6 funcionando (isso já travou o
# grupo localmente em 2026-09-11: timeout puro de socket, sem erro do
# Supabase). O Session pooler resolve em IPv4
# (aws-N-<região>.pooler.supabase.com), funciona em qualquer rede. Se
# o deploy no Railway também tiver problema de IPv6 no futuro, é a
# mesma troca. Lembrar de trocar postgresql:// por postgresql+asyncpg://
# e usar o usuário no formato postgres.<projeto> (não só "postgres").
DATABASE_URL=

# --- Autenticação do dispositivo IoT ---
#
# Chave GLOBAL do ADR 0003, hoje mantida apenas pelo ramo de transição
# de cloud/app/api/dispositivo_auth.py, para não derrubar um Pi em campo
# no momento do deploy. A credencial de verdade é POR DISPOSITIVO (ADR
# 0009): gerada por `python -m scripts.provisionar_dispositivo`, guardada
# como hash bcrypt em `dispositivos.chave_hash`, e nunca aqui.
#
# Cada uso da chave global grava aviso no log com o device_id. Quando
# não houver mais avisos, esta variável e o ramo de transição podem ser
# removidos juntos.
DEVICE_API_KEY=

# --- Autenticação do dashboard (JWT, ADR 0003 e ADR 0010) ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Modelo ---
# --- Envio de e-mail (confirmacao de cadastro e recuperacao de senha) ---
#
# OPCIONAIS. Sem nenhum deles a API sobe normalmente, mas o cadastro
# passa a criar contas JA VERIFICADAS (com aviso no log) e a
# recuperacao de senha nao funciona. E proposital: exigir confirmacao
# sem poder enviar o e-mail prenderia o produtor numa conta que ninguem
# consegue ativar.
#
# CAMINHO 1, o que vale em PRODUCAO: API HTTP do Brevo.
#
# O Railway BLOQUEIA as portas de SMTP (25, 465, 587, 2525) nos planos
# Free, Trial e Hobby. O projeto esta no Hobby, entao SMTP de la NUNCA
# funciona, por melhor que seja a configuracao. Servicos com API HTTP
# passam porque usam a porta 443.
#
# Como obter: criar conta gratuita em brevo.com (300 e-mails/dia, sem
# cartao), verificar o endereco remetente em Senders & IP, e gerar a
# chave em SMTP & API -> API Keys.
BREVO_API_KEY=

# CAMINHO 2, util em DESENVOLVIMENTO local, onde SMTP funciona.
#
# Para Gmail: ative a verificacao em duas etapas e gere uma "senha de
# app" em myaccount.google.com/apppasswords. A senha normal nao serve.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=

# Remetente dos e-mails, usado pelos DOIS caminhos. No Brevo precisa
# ser um endereco VERIFICADO na conta (Senders & IP), senao o envio e
# recusado. Em branco, usa o SMTP_USUARIO.
EMAIL_REMETENTE=

TFLITE_MODEL_PATH=ml/models/modelo.tflite
