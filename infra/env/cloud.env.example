# infra/env/cloud.env.example
#
# Template das variáveis de ambiente esperadas pelo backend (cloud/app/config.py).
# Copiar para um .env real (NUNCA versionado) ou configurar diretamente
# nas variáveis de ambiente do serviço no Railway.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ecovision-imagens
DATABASE_URL=

# --- Autenticação do dispositivo IoT (API Key estática, Blueprint Seção 4.3) ---
DEVICE_API_KEY=

# --- Autenticação do dashboard (JWT, Blueprint Seção 4.3) ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Modelo ---
TFLITE_MODEL_PATH=ml/models/modelo.tflite
