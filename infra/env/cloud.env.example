# Variáveis de ambiente da API (cloud/app/config.py).
# Copiar para cloud/.env ou configurar no serviço do Railway. Nunca versionar valores reais.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ecovision-imagens

# Cadeia de conexão do "Session pooler" do Supabase, que funciona por IPv4,
# com o prefixo postgresql+asyncpg:// e o usuário no formato postgres.<projeto>.
DATABASE_URL=

# --- Dispositivos ---
# Chave global anterior, mantida só por compatibilidade. A credencial de
# cada dispositivo é gerada por `python -m scripts.provisionar_dispositivo`
# e guardada como hash no banco.
DEVICE_API_KEY=

# --- Autenticação do aplicativo (JWT) ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- E-mail (confirmação de cadastro e recuperação de senha) ---
# Opcional. Sem configuração, as contas são criadas já verificadas e a
# recuperação de senha fica indisponível.
#
# Produção: API HTTP do Brevo (o Railway bloqueia as portas de SMTP).
BREVO_API_KEY=
# Desenvolvimento local: SMTP (no Gmail, use uma senha de app).
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
# Remetente usado pelos dois caminhos; no Brevo, precisa estar verificado.
EMAIL_REMETENTE=

# --- Modelo ---
TFLITE_MODEL_PATH=ml/models/modelo_dominio.tflite
